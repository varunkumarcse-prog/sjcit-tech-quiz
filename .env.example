# Add these in Netlify Site configuration > Environment variables.
# Do not commit real secret values to GitHub.
ONLINECOMPILER_API_KEY=PASTE_YOUR_PRIVATE_REST_API_KEY_IN_NETLIFY

# Optional: only required for the shared Supabase leaderboard.
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVER_SECRET
